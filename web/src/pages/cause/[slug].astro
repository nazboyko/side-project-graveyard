---
import type {GetStaticPaths, InferGetStaticPropsType} from 'astro'
import CauseFilter from '../../components/CauseFilter.astro'
import Graveyard from '../../components/Graveyard.astro'
import Layout from '../../layouts/Layout.astro'
import {getCauses, getProjects} from '../../lib/sanity'

export const getStaticPaths = (async () => {
  const [causes, projects] = await Promise.all([getCauses(), getProjects()])
  return causes.map((cause) => ({
    params: {slug: cause.slug},
    props: {
      cause,
      causes,
      graves: projects.filter((project) => project.cause.slug === cause.slug),
      total: projects.length,
    },
  }))
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const {cause, causes, graves, total} = Astro.props
---

<Layout title={`Cause of death: ${cause.title}`} description={cause.description}>
  <a class="back" href="/">Back to the graveyard</a>

  <header class="page-head">
    <p class="label">Cause of death</p>
    <h1>{cause.title}</h1>
    <p>{cause.description}</p>
  </header>

  <section class="section" aria-labelledby="graves-heading">
    <h2 id="graves-heading">{graves.length === 1 ? '1 grave' : `${graves.length} graves`}</h2>
    <Graveyard projects={graves} />
  </section>

  <CauseFilter causes={causes} total={total} current={cause.slug} />
</Layout>
