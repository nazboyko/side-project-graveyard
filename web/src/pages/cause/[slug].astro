---
import type {GetStaticPaths, InferGetStaticPropsType} from 'astro'
import Legend from '../../components/Legend.astro'
import Yard from '../../components/Yard.astro'
import Layout from '../../layouts/Layout.astro'
import {getCauses, getProjects} from '../../lib/sanity'

export const getStaticPaths = (async () => {
  const [causes, projects] = await Promise.all([getCauses(), getProjects()])
  return causes.map((cause) => ({
    params: {slug: cause.slug},
    props: {
      cause,
      causes,
      graves: projects.filter((project) => project.cause.slug === cause.slug),
      total: projects.length,
    },
  }))
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const {cause, causes, graves, total} = Astro.props
---

<Layout title={`Cause of death: ${cause.title}`} description={cause.description}>
  <a class="back" href="/">Back to the graveyard</a>

  <header class="page-head">
    <p class="label">Cause of death</p>
    <h1>{cause.title}</h1>
    <p>{cause.description}</p>
  </header>

  <div class="yard">
    <section class="graves" aria-labelledby="graves-heading">
      <h2 id="graves-heading" class="graves__count">{graves.length === 1 ? '1 grave' : `${graves.length} graves`}</h2>
      <Yard projects={graves} />
    </section>

    <div class="section legend-wrap">
      <Legend causes={causes} total={total} current={cause.slug} />
    </div>
  </div>
</Layout>
