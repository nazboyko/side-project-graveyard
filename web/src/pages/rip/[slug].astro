---
import type {GetStaticPaths, InferGetStaticPropsType} from 'astro'
import {PortableText} from 'astro-portabletext'
import Candle from '../../components/Candle.astro'
import Candles from '../../components/Candles.astro'
import Horizon from '../../components/Horizon.astro'
import Lifeline from '../../components/Lifeline.astro'
import Silhouette from '../../components/Silhouette.astro'
import Stone from '../../components/Stone.astro'
import Layout from '../../layouts/Layout.astro'
import {getProjects, type Mood} from '../../lib/sanity'
import {chipColor} from '../../lib/color'
import {describeMonument} from '../../lib/monument'
import {formatDate, formatYears} from '../../lib/stats'

export const getStaticPaths = (async () => {
  // Same order as the graveyard: by date of death, oldest first, the undead last.
  const projects = await getProjects()
  return projects.map((project, index) => ({
    params: {slug: project.slug},
    props: {
      project,
      previous: projects[index - 1] ?? null,
      next: projects[index + 1] ?? null,
    },
  }))
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const MOOD: Record<Mood, string> = {
  relief: 'Relief',
  guilt: 'Guilt',
  denial: 'Denial',
  peace: 'Peace',
}

const {project, previous, next} = Astro.props
const now = new Date()
const monument = describeMonument(project, now)
const undead = project.status === 'undead'
const figures = (project.monument?.figures ?? []).filter((figure) => figure?.value && figure?.label).slice(0, 3)
// The Studio only accepts https here, but the page does not take that on trust.
const ruinsUrl = project.repoUrl?.startsWith('https://') ? project.repoUrl : null
const lastSeen = undead
  ? `last seen · ${formatYears(project.bornAt, null)}`
  : project.diedAt && `final commit · ${formatDate(project.diedAt)}`
---

<Layout
  title={`${project.name} (${formatYears(project.bornAt, undead ? null : project.diedAt)})`}
  description={project.epitaph}
  strip={false}
>
  <article class="grave">
    <section class="memorial" data-candle={project.slug} aria-label={`The grave of ${project.name}`}>
      <div class="memorial__sky" aria-hidden="true">
        <Horizon variant="memorial" />
      </div>
      <a class="signpost signpost--back" href="/">
        <span class="signpost__board"><span aria-hidden="true">←</span> Back to the graveyard</span>
        <span class="signpost__post" aria-hidden="true"></span>
      </a>

      <div class="memorial__stand">
        {
          project.status === 'retired' && (
            <p class="marker-plate marker-plate--retired">Retired with honour</p>
          )
        }
        {
          undead && (
            <p class="marker-plate marker-plate--undead">
              <span class="stone__light" aria-hidden="true" />
              Undead
            </p>
          )
        }
        <Stone project={project} monument={monument} size="memorial">
          <Candles slot="front" />
        </Stone>
      </div>
      <Candle name={project.name} />
    </section>

    <Lifeline bornAt={project.bornAt} diedAt={project.diedAt} undead={undead} />

    <section class="ledger" aria-labelledby="autopsy-heading">
      <div class="ledger__sheet">
        <h2 id="autopsy-heading" class="ledger__title">Autopsy</h2>
        <dl class="ledger__rows">
          <div>
            <dt>{undead ? 'What keeps it down' : 'Cause of death'}</dt>
            <dd>
              <a class="stamp" href={`/cause/${project.cause.slug}/`}>
                {
                  project.cause.icon && (
                    <span class="stamp__mark" aria-hidden="true">
                      {project.cause.icon}
                    </span>
                  )
                }
                {project.cause.title}
              </a>
            </dd>
          </div>
          <div>
            <dt>Stack recovered</dt>
            <dd>
              <ul class="tags">
                {
                  project.stack.map((tech) => (
                    <li>
                      <a class="tags__tag" href={`/stack/${tech.slug}/`} style={chipColor(tech.color)}>
                        <span class="tags__swatch" aria-hidden="true" />
                        <span class="visually-hidden">Built with </span>
                        {tech.name}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </dd>
          </div>
          {
            project.lastCommit && (
              <div>
                <dt>Last words</dt>
                <dd>
                  <p class="last-words">
                    <code>“{project.lastCommit}”</code>
                  </p>
                  {lastSeen && <p class="last-words__when">{lastSeen}</p>}
                </dd>
              </div>
            )
          }
          {
            project.moodAtDeath && (
              <div>
                <dt>{undead ? 'Mood at last visit' : 'Mood at death'}</dt>
                <dd>{MOOD[project.moodAtDeath]}</dd>
              </div>
            )
          }
          {
            project.linesOfCode !== null && (
              <div>
                <dt>Lines of code</dt>
                <dd class="ledger__number">{project.linesOfCode.toLocaleString('en-US')}</dd>
              </div>
            )
          }
        </dl>
      </div>
    </section>

    {
      figures.length > 0 && (
        <ul class="figures" aria-label="Figures carved for this grave">
          {figures.map((figure) => (
            <li class="figures__medal">
              <span class="figures__value">{figure.value}</span>
              <span class="figures__label">{figure.label}</span>
            </li>
          ))}
        </ul>
      )
    }

    {
      project.obituary && project.obituary.length > 0 && (
        <section class="obituary" aria-labelledby="obituary-heading">
          <h2 id="obituary-heading">Obituary</h2>
          <div class="prose obituary__text">
            <PortableText value={project.obituary} />
          </div>
        </section>
      )
    }

    <section class="lesson" aria-labelledby="lesson-heading">
      <h2 id="lesson-heading">What it taught me</h2>
      <blockquote class="lesson__slab">
        <p>{project.lesson}</p>
      </blockquote>
    </section>

    {
      ruinsUrl && (
        <p class="ruins">
          <a class="signpost signpost--ruins" href={ruinsUrl} rel="noopener">
            <span class="signpost__board">
              <span class="signpost__text">
                Visit the ruins
                <span class="signpost__host">{new URL(ruinsUrl).hostname}</span>
              </span>
              <span class="signpost__arrow" aria-hidden="true">→</span>
            </span>
            <span class="signpost__post" aria-hidden="true" />
          </a>
        </p>
      )
    }

    <nav class="neighbours" aria-label="Neighbouring graves">
      {
        previous && (
          <a class="neighbours__sign" href={`/rip/${previous.slug}/`} rel="prev">
            <Silhouette monument={describeMonument(previous, now)} />
            <span class="neighbours__text">
              <span class="neighbours__label">Previous grave</span>{' '}
              <span class="neighbours__name">{previous.name}</span>
            </span>
          </a>
        )
      }
      {
        next && (
          <a class="neighbours__sign neighbours__sign--next" href={`/rip/${next.slug}/`} rel="next">
            <span class="neighbours__text">
              <span class="neighbours__label">Next grave</span>{' '}
              <span class="neighbours__name">{next.name}</span>
            </span>
            <Silhouette monument={describeMonument(next, now)} />
          </a>
        )
      }
    </nav>
  </article>
</Layout>
