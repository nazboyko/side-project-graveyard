---
import {PortableText} from 'astro-portabletext'
import Horizon from '../components/Horizon.astro'
import Legend from '../components/Legend.astro'
import Register from '../components/Register.astro'
import SceneImage from '../components/SceneImage.astro'
import Yard from '../components/Yard.astro'
import Layout from '../layouts/Layout.astro'
import {getCauses, getProjects, getSettings, getStats} from '../lib/sanity'

const [settings, projects, causes] = await Promise.all([getSettings(), getProjects(), getCauses()])
const stats = getStats(projects)
const count = projects.length === 1 ? '1 grave' : `${projects.length} graves`

const description = `${settings.tagline} ${projects.length} side projects, each with an epitaph, a cause of death, and the one thing it taught its author.`
---

<Layout description={description} strip={false}>
  <section class="gate" aria-labelledby="site-title">
    <Horizon variant="gate" />
    <SceneImage variant="gate" backdrop={settings.backdrop} />
    <div class="gate__text">
      <h1 id="site-title">{settings.title}</h1>
      <p class="gate__tagline">{settings.tagline}</p>
      <p class="gate__count">{count}. Enter quietly.</p>
    </div>
  </section>

  <div class="yard">
    <div class="approach">
      <section class="keeper-note" aria-labelledby="note-heading">
        <h2 id="note-heading" class="keeper-note__title">The keeper's note</h2>
        {settings.intro && <div class="prose"><PortableText value={settings.intro} /></div>}
      </section>
      <Register stats={stats} total={projects.length} />
      <Legend causes={causes} total={projects.length} />
    </div>

    <section class="graves" aria-labelledby="graves-heading">
      <h2 id="graves-heading" class="visually-hidden">The graves</h2>
      <p class="graves__note">The oldest are nearest the gate. The undead wait at the back.</p>
      <Yard projects={projects} />
    </section>
  </div>
</Layout>
