---
/**
 * One grave, drawn from its record. `plot` is the stone in the yard; `memorial` is the same stone, closer,
 * on its own page. Everything visual comes from describeMonument(); this file only arranges it.
 * Anything passed in the `front` slot stands in front of the stone's base (the candles on a grave page).
 */
import type {Project} from '../lib/sanity'
import type {Monument} from '../lib/monument'
import {formatDate, formatLifespan, formatYears, lifespanDays} from '../lib/stats'
import Art from './Art.astro'
import Plants from './Plants.astro'

interface Props {
  project: Project
  monument: Monument
  size?: 'plot' | 'memorial'
  /** The cemetery cat sits on this stone. */
  cat?: boolean
}

const {project, monument, size = 'plot', cat = false} = Astro.props
const {layout, shape, weathering, motif} = monument
const plot = size === 'plot'
const days = lifespanDays(project.bornAt, project.diedAt)
const undead = project.status === 'undead'
const lived = undead ? 'still twitching' : `lived ${formatLifespan(days ?? 0)}`
const years = undead
  ? `since ${formatYears(project.bornAt, project.bornAt)} · still twitching`
  : `${formatYears(project.bornAt, project.diedAt)} · ${lived}`
const href = `/rip/${project.slug}/`
const Name = plot ? 'h3' : 'h1'
// On a grave page the status stands above the stone; in the yard it is carved on it.
const status = !plot ? null : project.status === 'retired' ? 'Retired with honour' : undead ? 'Undead' : null
// On a marker the stone is too small for the epitaph; it goes on a wooden tag beside it.
const tagged = layout === 'marker'
---

<div
  class:list={[
    'monument',
    `monument--${size}`,
    `layout-${layout}`,
    `shape-${shape}`,
    `weather-${weathering}`,
    motif && `motif-${motif}`,
  ]}
>
  <Plants layer="back" weathering={weathering} motif={motif} layout={layout} />
  {
    motif === 'layers' && (
      <div class="monument__layers" aria-hidden="true">
        <span />
        <span />
      </div>
    )
  }
  <div class="stone">
    {
      cat && (
        <svg class="cat" viewBox="0 0 32 36" aria-hidden="true" focusable="false">
          <path
            class="cat__body"
            d="M9 35 C5 35 4 30 6 25 C7 21 9 18 10 15 C8 13 8 9 9 6 L11 1 L14 6 C15 5.6 17 5.6 18 6 L21 1 L23 6 C24 9 24 13 22 15 C23 18 25 21 26 25 C27 28 27 31 26 33 C29 33 31 31 31 28 C31 26 30 25 30 24 C31.5 24.5 32 26 32 28 C32 32 29 35 25 35 Z"
          />
          <circle class="cat__eye" cx="13.6" cy="10" r="1" />
          <circle class="cat__eye" cx="18.4" cy="10" r="1" />
        </svg>
      )
    }
    {layout === 'mausoleum' && <div class="stone__pediment" aria-hidden="true" />}
    <div class="stone__face">
      {
        status && layout !== 'plaque' && (
          <p class="stone__status">
            {undead && <span class="stone__light" aria-hidden="true" />}
            {status}
          </p>
        )
      }
      {
        (motif === 'laurel' || layout === 'plaque') && (
          <svg class="stone__laurel" viewBox="0 0 64 20" aria-hidden="true" focusable="false">
            <path d="M32 18 C24 16 14 12 6 4 M32 18 C40 16 50 12 58 4" />
            <path d="M12 9 q-5 -1 -6 -6 q5 0 6 6 M18 12 q-5 0 -7 -5 q5 0 7 5 M24 15 q-5 0 -7 -4 q5 -1 7 4" />
            <path d="M52 9 q5 -1 6 -6 q-5 0 -6 6 M46 12 q5 0 7 -5 q-5 0 -7 5 M40 15 q5 0 7 -4 q-5 -1 -7 4" />
          </svg>
        )
      }
      {project.cause.icon && !tagged && <span class="stone__mark" aria-hidden="true">{project.cause.icon}</span>}
      <div class="stone__plate">
        {layout === 'plaque' && status && <p class="stone__status">{status}</p>}
        <Name class="stone__name">{plot ? <a class="stone__link" href={href}>{project.name}</a> : project.name}</Name>
      </div>
      {
        plot ? (
          <p class="stone__years">{years}</p>
        ) : (
          <>
            <p class="stone__dates">
              <time datetime={project.bornAt}>{formatDate(project.bornAt)}</time>
              {project.diedAt && !undead && (
                <>
                  {' – '}
                  <time datetime={project.diedAt}>{formatDate(project.diedAt)}</time>
                </>
              )}
            </p>
            <p class="stone__lived">{lived}</p>
          </>
        )
      }
      {
        !tagged && (
          <>
            <p class="stone__epitaph">{project.epitaph}</p>
            {plot && <p class="stone__cause">{project.cause.title}</p>}
            {monument.inscription && <p class="stone__inscription">{monument.inscription}</p>}
          </>
        )
      }
    </div>
    {
      layout === 'mausoleum' && (
        <div class="stone__steps" aria-hidden="true">
          <span />
          <span />
          <span />
        </div>
      )
    }
  </div>
  <Plants layer="front" weathering={weathering} motif={motif} layout={layout} />
  {motif && <Art kind="motif" name={motif} />}
  {monument.relic && <Art kind="relic" name={monument.relic} />}
  <slot name="front" />
  {
    tagged && (
      <div class="tag">
        <span class="tag__stake" aria-hidden="true" />
        <div class="tag__card">
          {project.cause.icon && (
            <span class="tag__mark" aria-hidden="true">
              {project.cause.icon}
            </span>
          )}
          <p class="tag__epitaph">{project.epitaph}</p>
          {plot && <p class="tag__cause">{project.cause.title}</p>}
          {monument.inscription && <p class="tag__inscription">{monument.inscription}</p>}
        </div>
      </div>
    )
  }
</div>
