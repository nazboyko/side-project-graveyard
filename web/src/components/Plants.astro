---
/**
 * The ground a stone stands on, and what grows there. `back` is drawn behind the stone (the patch and its
 * shadow), `front` in front of its base (grass, weeds, flowers). All of it follows from weathering and motif.
 */
import type {Layout, Motif, Weathering} from '../lib/monument'

interface Props {
  layer: 'back' | 'front'
  weathering: Weathering
  motif: Motif | null
  layout: Layout
}

const {layer, weathering, motif, layout} = Astro.props
const honoured = motif === 'laurel' || layout === 'plaque'
const bare = weathering === 'fresh' || weathering === 'disturbed'

// Tufts by age: none on fresh soil, a few short ones once it settles, long grass on the oldest graves.
const TUFTS: Record<Weathering, {x: number; h: number}[]> = {
  fresh: [],
  disturbed: [{x: 196, h: 7}],
  settled: [
    {x: 44, h: 8},
    {x: 194, h: 7},
  ],
  aged: [
    {x: 36, h: 10},
    {x: 60, h: 7},
    {x: 200, h: 11},
  ],
  ancient: [
    {x: 26, h: 15},
    {x: 48, h: 11},
    {x: 70, h: 8},
    {x: 182, h: 9},
    {x: 206, h: 16},
  ],
}
const tufts = motif === 'emptyPlot' ? [] : honoured ? [] : TUFTS[weathering]
const tuft = (x: number, h: number) =>
  `M${x - 6} 40 Q${x - 5} ${40 - h * 0.6} ${x - 8} ${40 - h} Q${x - 2} ${40 - h * 0.5} ${x} 40 Z ` +
  `M${x - 1} 40 Q${x} ${40 - h * 0.8} ${x + 1} ${40 - h * 1.15} Q${x + 3} ${40 - h * 0.6} ${x + 3} 40 Z ` +
  `M${x + 2} 40 Q${x + 5} ${40 - h * 0.5} ${x + 9} ${40 - h * 0.85} Q${x + 5} ${40 - h * 0.35} ${x + 7} 40 Z`
---

{
  layer === 'back' ? (
    <svg class="plants plants--back" viewBox="0 0 240 48" preserveAspectRatio="xMidYMax meet" aria-hidden="true" focusable="false">
      <ellipse class="plants__shadow" cx="120" cy="40" rx="78" ry="6" />
      {bare ? (
        <path
          class="plants__soil"
          d={
            weathering === 'disturbed'
              ? 'M42 44 C60 30 120 28 168 26 C190 25 204 32 206 44 Z'
              : 'M40 44 C58 32 96 30 120 30 C150 30 184 32 200 44 Z'
          }
        />
      ) : (
        <ellipse class="plants__grass" cx="120" cy="42" rx="104" ry="7" />
      )}
      {weathering === 'disturbed' && (
        <path class="plants__crack" d="M92 34 L100 38 L96 42 M134 30 L140 35 L150 33 M170 29 L176 36" />
      )}
    </svg>
  ) : (
    <svg class="plants plants--front" viewBox="0 0 240 48" preserveAspectRatio="xMidYMax meet" aria-hidden="true" focusable="false">
      {tufts.length > 0 && <path class="plants__tuft" d={tufts.map(({x, h}) => tuft(x, h)).join(' ')} />}
      {honoured && (
        <g class="plants__trim">
          <path d="M36 44 h168 v4 h-168 Z" />
          <path d={Array.from({length: 28}, (_, i) => `M${38 + i * 6} 44 l2 -3 l2 3 Z`).join(' ')} />
        </g>
      )}
      {honoured && (
        <g class="plants__flowers">
          <path
            class="plants__stem"
            d="M60 46 C60 34 57 27 54 21 M68 46 C68 33 70 26 73 19 M76 46 C76 37 79 31 83 27 M164 46 C164 35 161 29 158 24 M172 46 C172 33 175 25 178 20 M180 46 C181 38 184 33 188 30"
          />
          <path class="plants__leafs" d="M62 40 q-7 -2 -9 -8 q7 1 9 8 M74 38 q7 -3 9 -9 q-7 2 -9 9 M166 39 q-7 -2 -9 -8 q7 1 9 8 M176 37 q7 -3 9 -9 q-7 2 -9 9" />
          <circle class="plants__bloom" cx="54" cy="19" r="4.6" />
          <circle class="plants__bloom plants__bloom--warm" cx="73" cy="17" r="4.4" />
          <circle class="plants__bloom" cx="83" cy="25" r="3.8" />
          <circle class="plants__bloom plants__bloom--warm" cx="158" cy="22" r="4.4" />
          <circle class="plants__bloom" cx="178" cy="18" r="4.6" />
          <circle class="plants__bloom" cx="188" cy="28" r="3.6" />
          <circle class="plants__heart" cx="54" cy="19" r="1.5" />
          <circle class="plants__heart" cx="83" cy="25" r="1.3" />
          <circle class="plants__heart" cx="178" cy="18" r="1.5" />
          <circle class="plants__heart" cx="188" cy="28" r="1.2" />
        </g>
      )}
      {motif === 'overgrown' && (
        <g class="plants__weeds">
          <path d="M16 46 C19 28 12 12 4 0 C16 12 23 28 23 46 Z M28 46 C31 30 34 16 42 4 C37 20 35 32 35 46 Z M36 46 C36 38 40 30 48 24 C43 32 41 39 41 46 Z M210 46 C208 28 214 12 224 2 C218 18 216 32 217 46 Z M222 46 C225 34 230 24 240 18 C233 28 229 37 228 46 Z" />
          <path class="plants__leaf" d="M140 44 C146 38 156 38 160 42 C154 46 146 47 140 44 Z" />
        </g>
      )}
    </svg>
  )
}
