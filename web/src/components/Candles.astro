---
/** Seven candles at the foot of a stone, all unlit and hidden until the candle script shows them. */
const SPOTS = [
  {x: 0, h: 2.3},
  {x: -2.3, h: 1.8},
  {x: 2.3, h: 2},
  {x: -4.3, h: 1.5},
  {x: 4.4, h: 1.7},
  {x: -1.15, h: 1.4},
  {x: 3.35, h: 1.3},
]
---

<div class="candles" aria-hidden="true">
  {
    SPOTS.map(({x, h}) => (
      <span class="candles__one" style={`--x:${x}rem;--h:${h}rem`} hidden>
        <span class="candles__halo" />
        <span class="candles__flame" />
        <span class="candles__wax" />
      </span>
    ))
  }
</div>
