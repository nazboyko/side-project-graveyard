---
import type {Project} from '../lib/sanity'
import Tombstone from './Tombstone.astro'

interface Props {
  projects: Project[]
}

const {projects} = Astro.props
---

{
  projects.length > 0 ? (
    <ul class="graveyard">
      {projects.map((project) => (
        <li>
          <Tombstone project={project} />
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty">No graves here yet. The ground is still soft.</p>
  )
}
