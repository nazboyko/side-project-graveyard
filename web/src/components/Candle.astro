---
/**
 * The candle ceremony at the foot of a stone. `Candles` (the slot of Stone) draws up to seven candles;
 * `Candle` is the button, the count and the honest note. Both sit inside one `[data-candle]` element.
 * Without JavaScript the control stays hidden and no candle is drawn: nothing pretends to work.
 */
interface Props {
  name: string
}

const {name} = Astro.props
---

<div class="vigil" hidden>
  <button class="vigil__button" type="button" aria-describedby="vigil-note">
    <svg class="vigil__icon" viewBox="0 0 16 24" aria-hidden="true" focusable="false">
      <path d="M8 2 c3 4 4 6 4 8 a4 4 0 0 1 -8 0 c0 -2 1 -4 4 -8 Z" />
      <rect x="5" y="14" width="6" height="9" rx="1" />
    </svg>
    <span class="vigil__label">Light a candle</span>
    <span class="visually-hidden"> for {name}</span>
  </button>
  <p class="vigil__count" role="status"></p>
  <p class="vigil__note" id="vigil-note">Candles are counted in this browser only.</p>
</div>

<script>
  const KEY_PREFIX = 'graveyard:candles:'
  const DRAWN = 7

  function readCount(key: string): number {
    try {
      const stored = Number(localStorage.getItem(key))
      return Number.isInteger(stored) && stored > 0 ? stored : 0
    } catch {
      return 0
    }
  }

  function writeCount(key: string, count: number): void {
    try {
      localStorage.setItem(key, String(count))
    } catch {
      // Storage is blocked or full. The candle still burns until the page is closed.
    }
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-candle]')) {
    const vigil = root.querySelector<HTMLElement>('.vigil')
    const button = root.querySelector('button')
    const label = root.querySelector('.vigil__label')
    const status = root.querySelector('[role="status"]')
    const candles = [...root.querySelectorAll<HTMLElement>('.candles__one')]
    if (!vigil || !button || !label || !status) continue

    const key = KEY_PREFIX + root.dataset.candle
    let count = readCount(key)

    const render = (fresh: boolean) => {
      root.toggleAttribute('data-lit', count > 0)
      candles.forEach((candle, index) => {
        candle.hidden = index >= Math.min(count, DRAWN)
        candle.classList.toggle('is-new', fresh && index === Math.min(count, DRAWN) - 1)
      })
      label.textContent = count > 0 ? 'Light another candle' : 'Light a candle'
      status.textContent =
        count === 0 ? 'No candle lit here yet.' : count === 1 ? '1 candle lit here' : `${count} candles lit here`
    }

    button.addEventListener('click', () => {
      count += 1
      writeCount(key, count)
      render(true)
    })

    render(false)
    vigil.hidden = false
  }
</script>
